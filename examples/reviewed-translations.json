[
  {
    "cue_id": 1,
    "text": "ללהב הזה עבר אפל."
  },
  {
    "cue_id": 2,
    "text": "הוא שפך דם של חפים מפשע רבים."
  },
  {
    "cue_id": 3,
    "text": "את טיפשה שיצאת לדרך לבד,\nלגמרי לא מוכנה."
  },
  {
    "cue_id": 4,
    "text": "יש לך מזל שעוד זורם לך דם בעורקים."
  },
  {
    "cue_id": 5,
    "text": "תודה."
  },
  {
    "cue_id": 6,
    "text": "אז..."
  },
  {
    "cue_id": 7,
    "text": "מה מביא אותך לארץ שומרי השער?"
  },
  {
    "cue_id": 8,
    "text": "אני מחפשת מישהו."
  },
  {
    "cue_id": 9,
    "text": "מישהו יקר לך? נפש תאומה?"
  },
  {
    "cue_id": 10,
    "text": "דרקון."
  },
  {
    "cue_id": 11,
    "text": "מסע מסוכן לציידת בודדה."
  },
  {
    "cue_id": 12,
    "text": "אני לבד מאז שאני זוכרת את עצמי."
  },
  {
    "cue_id": 13,
    "text": "כמעט סיימנו. ששש..."
  },
  {
    "cue_id": 14,
    "text": "היי, לא לזוז."
  },
  {
    "cue_id": 15,
    "text": "לילה טוב, סקיילס."
  },
  {
    "cue_id": 16,
    "text": "עליו, סקיילס! קדימה!"
  },
  {
    "cue_id": 17,
    "text": "סקיילס?"
  },
  {
    "cue_id": 18,
    "text": "יש! קדימה!"
  },
  {
    "cue_id": 19,
    "text": "סקיילס!"
  },
  {
    "cue_id": 20,
    "text": "נכשלתי."
  },
  {
    "cue_id": 21,
    "text": "פשוט לא ראית..."
  },
  {
    "cue_id": 22,
    "text": "זו ארץ הדרקונים, סינטל."
  },
  {
    "cue_id": 23,
    "text": "את קרובה יותר משנדמה לך."
  },
  {
    "cue_id": 24,
    "text": "סקיילס!"
  },
  {
    "cue_id": 25,
    "text": "סקיילס?"
  },
  {
    "cue_id": 26,
    "text": "סקיילס..."
  }
]
